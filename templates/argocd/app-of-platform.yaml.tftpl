apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: app-of-platform
  namespace: argocd
spec:
  destination:
    server: "https://kubernetes.default.svc"
    namespace: argocd
  project: default
  source:
    path: ${path}
    repoURL: ${repo_url}
    targetRevision: ${revision}
    directory:
      recurse: true
  syncPolicy:
    automated:
      prune: true
      selfHeal: true
